<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 푸시 자동 배포(ADR-060). 1분마다 gwsvc로 GitHub main을 확인한다(pull 방식, 들어오는 연결 없음).
     건강 확인을 통과한 운영 릴리스(app)의 스크립트를 쓰고, 없을 때만 setup-host가 넣은 bootstrap 사본을 쓴다. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ssamuniverse.gallery.autodeploy</string>
  <key>UserName</key><string>__GW_USER__</string>
  <key>WorkingDirectory</key><string>/Users/__GW_USER__/gallery-server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>d=/Users/__GW_USER__/gallery-server; s=$d/app/ops/macmini/scripts; [ -f "$s/auto-deploy.sh" ] || s=$d/bootstrap/scripts; exec /bin/sh "$s/auto-deploy.sh"</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>HOME</key><string>/Users/__GW_USER__</string></dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>/Users/__GW_USER__/gallery-server/logs/autodeploy.log</string>
  <key>StandardErrorPath</key><string>/Users/__GW_USER__/gallery-server/logs/autodeploy.log</string>
</dict>
</plist>
