{
  "name": "@gallery/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "갤러리 서버: Hono + SQLite + 작품 처리, 맥미니 Node 프로세스 하나",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "build": "node -e \"require('node:fs').cpSync('src/store/migrations', 'dist/store/migrations', { recursive: true })\""
  },
  "dependencies": {
    "@gallery/core": "*",
    "@hono/node-server": "2.1.6",
    "better-sqlite3": "13.0.3",
    "busboy": "1.6.0",
    "file-type": "22.3.0",
    "hono": "4.13.16",
    "music-metadata": "12.3.4",
    "sharp": "0.35.5",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/busboy": "1.5.5",
    "@types/ws": "8.18.2"
  }
}
